{
  "name": "agent-fanni-kupuri",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "start": "node scripts/start-fanni-space.mjs",
    "space": "CUSTOMWARE_PATH=./customware node space-agent/space.js serve",
    "space:dev": "CUSTOMWARE_PATH=./customware node space-agent/space.js serve",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "lint": "eslint src server scripts tests --ext .js,.jsx --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.js",
    "test:unit": "node --test tests/production-runtime.test.js tests/checkpoint-rollback.test.js tests/zernio-social.test.js tests/billing.test.js tests/public-site.test.js",
    "test:integration": "node --test tests/workspace-isolation.test.js",
    "test:e2e": "echo 'E2E requires live Supabase + deployed runtime; see docs/LOCAL_DEVELOPMENT.md'",
    "zernio:check": "node scripts/zernio-setup.mjs check",
    "zernio:setup": "node scripts/zernio-setup.mjs",
    "pulso:demo": "node scripts/run-fanni-pulso-demo.mjs",
    "gauntlet:site": "node scripts/site-gauntlet.mjs",
    "validate:production": "node scripts/validate-production.mjs",
    "validate:migrations": "node scripts/validate-migrations.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "check": "npm run security:scan && npm run validate:production && npm run gauntlet:site && npm run test && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.8.0",
    "typescript": "^7.0.2",
    "vite": "^6.0.5"
  }
}
