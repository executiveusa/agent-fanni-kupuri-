# =============================================================================
# Agent Fanni — Environment Variable Contract
# Kupuri Media · Supabase project: botanic-creations (cyxdevcjycmffhmwxojh)
# =============================================================================
# NEVER commit .env, .env.local, or .env.production to source control.
# Server-only values must NEVER use the VITE_ prefix.
# Browser-safe values must contain only publishable or anonymous data.
# =============================================================================

# ── Browser-safe (Vite inlines at build time) ──────────────────────────────
VITE_SUPABASE_URL=https://cyxdevcjycmffhmwxojh.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_FANNI_WORKSPACE_SLUG=agent-fanni-demo
VITE_FANNI_ENV=preview
VITE_FANNI_API_BASE_URL=
VITE_FANNI_AVATAR_VARIANT=a
VITE_EXTERNAL_WRITES_ENABLED=false
VITE_REAL_CLIENT_DATA_ENABLED=false
VITE_DEMO_MODE=true

# ── Server-only ────────────────────────────────────────────────────────────
SUPABASE_URL=https://cyxdevcjycmffhmwxojh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
FANNI_DATABASE_URL=
FANNI_JWT_SIGNING_SECRET=
FANNI_WEBHOOK_SIGNING_SECRET=

# ── Composio: Fanni's permissioned app/data arms ─────────────────────────
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://backend.composio.dev/api/v3.1
COMPOSIO_TIMEOUT_MS=30000
COMPOSIO_ALLOWED_TOOLKITS=gmail,googlecalendar,googledrive,slack,notion,airtable,hubspot,github,dropbox,canva,instagram,linkedin,facebook
# Every Composio session uses a stable Fanni organization+workspace user ID.
# Multiple accounts require explicit account selection. Never expose this key to Vite.

# ── Model providers ────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_CLASSIFICATION_MODEL=gpt-4o-mini
OPENAI_SYNTHESIS_MODEL=gpt-4o
OPENAI_REPORT_MODEL=gpt-4o
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
COMMAND_R_API_KEY=
COHERE_API_KEY=
COHERE_MODEL=command-r-plus
QVAC_BASE_URL=http://127.0.0.1:8000/v1
QVAC_MODEL=
FAL_KEY=

# ── Voice ─────────────────────────────────────────────────────────────────
FANNI_TTS_PROVIDER=elevenlabs
FANNI_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
FANNI_TTS_STABILITY=0.5
FANNI_TTS_SIMILARITY_BOOST=0.75
FANNI_TTS_STYLE=0.15
FANNI_TTS_SPEED=0.96

# ── Social operations through Zernio ──────────────────────────────────────
ZERNIO_API_KEY=
ZERNIO_BASE_URL=https://zernio.com/api/v1
ZERNIO_WEBHOOK_SECRET=
ZERNIO_WEBHOOK_URL=
ZERNIO_TIMEOUT_MS=30000
ZERNIO_RECONCILE_AFTER_MINUTES=15
ZERNIO_ANALYTICS_SYNC_HOURS=24
ZERNIO_INBOX_SYNC_MINUTES=15
POSTIZ_API_URL=
POSTIZ_API_KEY=

# ── Space Agent ───────────────────────────────────────────────────────────
CUSTOMWARE_PATH=./customware
SINGLE_USER_APP=true
SPACE_AGENT_PORT=3000
FANNI_SIDECAR_URL=http://localhost:3001

# ── Runtime controls ──────────────────────────────────────────────────────
FANNI_PROVIDER_TIMEOUT_MS=60000
FANNI_MAX_PROVIDER_RETRIES=2
FANNI_DAILY_COST_LIMIT_USD=10
FANNI_MEMORY_MAX_RESULTS=12
FANNI_MEMORY_MINIMUM_SIMILARITY=0.72
PORT=3001

# ── Safety gates ──────────────────────────────────────────────────────────
FANNI_ALLOW_EXTERNAL_WRITES=false
FANNI_ALLOW_REAL_CLIENT_DATA=false
FANNI_NETWORK_MODE=deny_by_default